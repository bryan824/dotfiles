#!/usr/bin/env bash
#MISE description="Re-apply the copier template to this project"
#MISE dir="{{cwd}}"
#USAGE flag "--ask" help="Re-prompt the template questions instead of reusing the recorded answers"
#
# Pulls later template changes into a project generated by preset:python or
# preset:rust, three-way merging them against local edits. Reads the recorded
# answers from .copier-answers.yml, so it only works in a generated project.
#
# The project must be a git repo with a clean tree — copier refuses otherwise,
# since the merge needs somewhere to put the old version.
set -euo pipefail

args=(--trust)
[[ -n ${usage_ask:-} ]] || args+=(--defaults)

uvx copier update "${args[@]}"
