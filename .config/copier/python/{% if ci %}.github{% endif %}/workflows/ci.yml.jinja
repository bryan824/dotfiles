name: check

on:
  push:
    branches: [main]
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: jdx/mise-action@v3
      # mise.toml pins the tools; pyproject.toml pins ruff and pytest.
      - run: mise run sync
      - run: mise run check
