# Generated by `mise run preset:python`; `uvx copier update --trust` re-applies
# later template changes. Task names match the rust preset on purpose.

# What the tasks below shell out to, so `mise install` gives a fresh clone
# everything `mise run check` and `mise run watch` need. ruff and pytest are
# pinned by the dev group in pyproject.toml, not here.
[tools]
uv = "latest"
watchexec = "latest"
{%- if hooks %}
hk = "latest"
{%- endif %}

[tasks.sync]
description = "Install the locked dependencies"
alias = "s"
run = "uv sync --locked"

[tasks.fmt]
description = "Format the code in place"
run = "uv run ruff format ."

[tasks.lint]
description = "Lint without writing (CI-safe)"
run = "uv run ruff check ."

[tasks.types]
description = "Type-check with ty"
run = "uv check"

[tasks.test]
description = "Run tests from the project environment"
alias = "t"
run = "uv run --locked pytest"

[tasks.fix]
description = "Apply every safe automatic fix"
run = ["uv run ruff check --fix .", "uv run ruff format ."]

# The gate. depends run in parallel, and all three only read.
[tasks.check]
description = "lint + types + test"
alias = "c"
depends = ["lint", "types", "test"]

[tasks.build]
description = "Build sdist and wheel into dist/"
run = "uv build"

[tasks.watch]
description = "Re-run check on every save"
run = "watchexec -e py -- mise run check"
