# Generated by `mise run preset:rust`; `uvx copier update --trust` re-applies
# later template changes. Task names match the python preset on purpose.

# What the tasks below shell out to, so `mise install` gives a fresh clone
# everything `mise run check` and `mise run watch` need. No `rust`: rustup owns
# the toolchain, and pinning it here would shadow a project's rust-toolchain.toml.
[tools]
"cargo:cargo-nextest" = "latest"
watchexec = "latest"
{%- if hooks %}
hk = "latest"
{%- endif %}

[tasks.sync]
description = "Fetch the locked dependencies"
alias = "s"
run = "cargo fetch --locked"

[tasks.fmt]
description = "Format the code in place"
run = "cargo fmt --all"

[tasks.lint]
description = "Clippy with warnings as errors (CI-safe)"
run = "cargo clippy --all-targets --all-features -- -D warnings"

[tasks.test]
description = "Run tests with nextest"
alias = "t"
# --no-tests=pass: nextest exits non-zero on an empty suite by default, which
# fails the gate on a project that has not written its first test yet.
run = "cargo nextest run --all-features --no-tests=pass"

[tasks.fix]
description = "Apply every safe automatic fix"
run = [
  "cargo clippy --fix --allow-dirty --allow-staged --all-targets",
  "cargo fmt --all",
]

# The gate. depends run in parallel, and both only read.
[tasks.check]
description = "lint + test"
alias = "c"
depends = ["lint", "test"]

[tasks.build]
description = "Build the release binary"
run = "cargo build --release"

[tasks.run]
description = "Run the debug binary"
alias = "r"
run = "cargo run"

[tasks.watch]
description = "Re-run check on every save"
run = "watchexec -e rs -- mise run check"
