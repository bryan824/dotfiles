// Git hooks via hk. See the python template for the reasoning. The step list
// is imported live from the dotfiles repo rather than copied here, so a linter
// added there reaches this project with no `mise run preset:update`.
amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
import "https://raw.githubusercontent.com/bryan824/dotfiles/main/.config/hk/common.pkl" as Shared

// Shared.rust = hygiene + cargo fmt/clippy. Add project-only steps by amending:
//   local linters = (Shared.rust) { ["deny"] { check = "cargo deny check" } }
local linters = Shared.rust

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
